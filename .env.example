# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` - it contains secrets.

# --- Africa's Talking (developer sandbox) ---
# Create a free account at https://africastalking.com and use the sandbox app keys.
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here

# Shortcode / sender used by Africa's Talking.
# In the sandbox the USSD code is usually *384*<your-app-id># and SMS sender is your shortcode.
AT_SENDER_ID=UMUHINZI
AT_USSD_CODE=*123#

# --- Outbreak early warning ---
# Number of reports of the same pest in one sector within the window that triggers an alert.
OUTBREAK_THRESHOLD=3
OUTBREAK_WINDOW_DAYS=7

# --- Local storage ---
# SQLite file used for diagnoses, registrations and alerts.
DATABASE_PATH=umuhinzi.db

# --- Mock / dry-run switches ---
# When no Africa's Talking API key is set, SMS/voice sends are only logged (dry-run).
# Keep ASR_BACKEND=mock for local demos; set it to sunbird to use real Kinyarwanda
# speech recognition. If Sunbird fails, the app falls back to mock / asks the
# farmer to repeat.
ASR_BACKEND=mock
TTS_BACKEND=mock

# Optional demo hook: text the mock ASR should "hear" for any uploaded audio.
# Leave empty to simulate "I did not hear you" and ask the farmer to repeat.
MOCK_ASR_TEXT=

# --- Sunbird AI speech-to-text (optional, free developer tier) ---
# Get a token from https://api.sunbird.ai/keys (or POST /auth/token).
# Paste it only in your local `.env`, never in code or git.
SUNBIRD_API_TOKEN=
SUNBIRD_STT_URL=https://api.sunbird.ai/tasks/audio/transcriptions
SUNBIRD_TIMEOUT_SECONDS=45
